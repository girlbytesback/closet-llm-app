# Secrets — never commit API keys
.env
.env.*
!.env.example

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
 
# Node
node_modules/

# Vite dep-optimizer cache. The deps_temp_* dirs carry a fresh hash each run,
# so ignore the whole cache rather than individual paths.
.vite/

# Tool caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Photos — local-only now. Uploads go straight to the storage bucket, and the
# UI renders signed links from it, so nothing in here needs to ship with a
# deploy. garments/ and color-palettes/ feed the offline extraction CLI;
# assets/garments/ holds the web-sized copies scripts/resize_imgs.py makes.
garments/
assets/garments/
color-palettes/

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Claude Code local overrides (a shared settings.json stays tracked)
.claude/settings.local.json
